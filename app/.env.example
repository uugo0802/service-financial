# Supabaseプロジェクトの接続情報（未設定の間はDB/認証系の機能を使わずアプリは動作する）。
# 値は Supabaseダッシュボード > Project Settings > API から取得する。
# docs/cto-tech-architecture.md 4.2「データセキュリティ最低要件」の方針:
# - Row Level Security(RLS)でテナントごとにデータアクセスを強制分離すること
# - マイナンバー等の機微情報はDBに非保持とすること
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー側限定（監査ログへのINSERT等、RLSをバイパスする必要がある処理専用）。
# クライアントに絶対に公開しないこと。NEXT_PUBLIC_ prefixを付けない。
SUPABASE_SERVICE_ROLE_KEY=
